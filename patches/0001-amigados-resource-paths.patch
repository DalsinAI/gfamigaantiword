+++ b/fonts_u.c	2026-11-16 21:54:54.063314886 +0000
@@ -34,6 +34,46 @@
 	szEnvironmentFile[0] = '\0';
 	szLocalFile[0] = '\0';
 
+#if defined(__amigaos)
+	/* AmigaDOS paths: ANTIWORDHOME, HOME/.antiword, then the global one */
+	{
+		char	szDir[PATH_MAX+1];
+		char	szGlobal[PATH_MAX+1];
+
+		szAntiword = szGetAntiwordDirectory();
+		if (szAntiword != NULL && szAntiword[0] != '\0' &&
+		    bAmigaJoin(szEnvironmentFile, sizeof(szEnvironmentFile),
+				szAntiword, FONTNAMES_FILE)) {
+			DBG_MSG(szEnvironmentFile);
+			pFile = fopen(szEnvironmentFile, "r");
+			if (pFile != NULL) {
+				return pFile;
+			}
+		}
+		szHome = szGetHomeDirectory();
+		if (szHome[0] != '\0' &&
+		    bAmigaJoin(szDir, sizeof(szDir), szHome, ANTIWORD_DIR) &&
+		    bAmigaJoin(szLocalFile, sizeof(szLocalFile),
+				szDir, FONTNAMES_FILE)) {
+			DBG_MSG(szLocalFile);
+			pFile = fopen(szLocalFile, "r");
+			if (pFile != NULL) {
+				return pFile;
+			}
+		}
+		(void)bAmigaJoin(szGlobal, sizeof(szGlobal),
+				GLOBAL_ANTIWORD_DIR, FONTNAMES_FILE);
+		DBG_MSG(szGlobal);
+		pFile = fopen(szGlobal, "r");
+		if (pFile != NULL) {
+			return pFile;
+		}
+		werr(0, "I can not open your fontnames file.\n"
+			"It is not in ANTIWORDHOME nor in '%s'.", szGlobal);
+		return NULL;
+	}
+#endif /* __amigaos */
+
